# Copy to .env, then choose a local-only password. Never commit .env.
POSTGRES_DB=shiros
POSTGRES_USER=shiros
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Separate fields avoid password URL-escaping problems.
SHIROS_DB_HOST=127.0.0.1
SHIROS_DB_PORT=55432
SHIROS_DB_NAME=shiros
SHIROS_DB_USER=shiros
SHIROS_DB_PASSWORD=
# Set both passwords above to the same local value.
# Integration tests require a separate disposable database, e.g. shiros_test.
# SHIROS_TEST_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:55432/shiros_test

